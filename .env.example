# Big Brain Ape The MemeCoin Sniper
# Copy to .env and fill secrets locally or in the host. Never commit .env.

BOT_NAME=Big Brain Ape The MemeCoin Sniper
BOT_TAGLINE=The head ape hunts while you sleep.

# From @BotFather for @Big_Brain_Ape_Bot. Required to poll.
TELEGRAM_BOT_TOKEN=

# Optional. When set, free-form chat lines can be rewritten in character.
# Paper fills, Shield verdicts, and the journal stay deterministic either way.
OPENAI_API_KEY=

# Optional. Helius enriches Solana candidates (mint/freeze) and, unless you set
# a custom RPC_SOLANA, becomes the Solana RPC for balance reads.
HELIUS_API_KEY=

# Optional. Alchemy checks EVM bytecode on market candidates and, unless you set
# custom RPC_ETHEREUM / RPC_BASE, becomes those RPCs for balance reads.
ALCHEMY_API_KEY=

# Paper desk is the default. Live mode arms only when ALL of these are set:
#   LIVE_TRADING=true
#   LIVE_TRADING_CONFIRM=I_UNDERSTAND
#   WALLET_ENCRYPTION_KEY=<backed-up secret, 32+ characters>
# Anything else stays on paper. This build still has no signer and no broadcaster.
LIVE_TRADING=false
LIVE_TRADING_CONFIRM=

# Public links (used in bot + website)
TELEGRAM_BOT_USERNAME=Big_Brain_Ape_Bot
WEBSITE_URL=http://localhost:4321
DOCS_URL=http://localhost:4321/docs
CHANNEL_URL=

# AES-256-GCM key. Required before any wallet is encrypted or exported.
# Generate one with: openssl rand -base64 32
# Back it up offline before a deposit. If this key is lost, stored private keys
# cannot be decrypted. Live funds must use a backed-up key. Never commit the real value.
# Placeholder text (change-me, dev-only) is refused.
WALLET_ENCRYPTION_KEY=

# Postgres. Optional for the paper desk. Without it, wallet rows stay in memory
# and disappear when the process restarts.
DATABASE_URL=postgres://snipr:snipr@localhost:5432/snipr

# Optional JSON file for the paper book. Leave unset in tests.
# PAPER_DESK_PATH=data/paper-desk.json

# Durable disk for the journal, paper wallets, and (when Postgres is down) encrypted
# wallet rows. On a Hugging Face Space, mount storage at /data and leave DATA_DIR=/data.
# Local default: SQLite at ./data/durable.sqlite and JSONL at ./logs/days/YYYY-MM-DD/events.jsonl.
# DATA_DIR=/data
# DURABLE_DB_PATH=/data/durable.sqlite
# JOURNAL_ROOT=/data/logs
# EXPORT_DIR=/data/exports

# Optional UTC nightly journal summary. Off unless the exact string true, and a chat id is set.
# LEARN_NIGHTLY=false
# LEARN_CHAT_ID=

# Hugging Face webhook. Leave unset for local/Railway long polling.
# WEBHOOK_URL=https://simzy-big-brain-ape-bot.hf.space/telegram/webhook
# WEBHOOK_SECRET=

# Minimum USD to unlock Activate
MIN_FUND_USD=100

# Promo banner
PROMO_HOURS=48
PROMO_ENABLED=true

# Daily trade archives (UTC midnight rotation). Live fills are gitignored here.
TRADE_ARCHIVE_ROOT=data/trade-archives
TRADE_ARCHIVE_REMOTE=https://github.com/Simzy420/bba-trade-archives
TRADE_ENGINE_LIVE=false

# Price feed
COINGECKO_API_URL=https://api.coingecko.com/api/v3

# RPC endpoints. Public defaults are fine for paper. Dedicated keys above
# replace Ethereum, Base, and Solana when those URLs are left on the defaults.
RPC_ETHEREUM=https://ethereum.publicnode.com
RPC_BASE=https://base.publicnode.com
RPC_BSC=https://bsc.publicnode.com
RPC_MONAD=
RPC_ROBINHOOD=
RPC_SOLANA=https://api.mainnet-beta.solana.com
