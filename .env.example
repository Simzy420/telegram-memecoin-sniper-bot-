# Snipr — placeholder. Replace when you pick a name.
BOT_NAME=Snipr
BOT_TAGLINE=Autonomous memecoin agent

# From @BotFather
TELEGRAM_BOT_TOKEN=

# Public links (used in bot + website)
TELEGRAM_BOT_USERNAME=
WEBSITE_URL=http://localhost:4321
DOCS_URL=http://localhost:4321/docs
CHANNEL_URL=

# AES-256-GCM key: 32+ byte secret (use a long random string)
