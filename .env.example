# Copy to .env and fill in values. Never commit real secrets.

# Telegram bot token from @BotFather. Required only for live (Telegram-connected) mode.
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to control the bot. Empty = allow everyone.
ALLOWED_USER_IDS=

# Trading mode: "dry-run" simulates trades (safe default) or "live" to place real orders.
TRADING_MODE=dry-run

# Chain to snipe on (informational for this scaffold): solana | ethereum | base | bsc
CHAIN=solana

# Amount of quote currency to spend per snipe (e.g. SOL or ETH).
BUY_AMOUNT=0.1

# Take-profit and stop-loss as decimal fractions (0.5 = +50%, 0.2 = -20%).
TAKE_PROFIT=0.5
STOP_LOSS=0.2

# Max slippage tolerated on a buy, as a decimal fraction (0.15 = 15%).
MAX_SLIPPAGE=0.15
