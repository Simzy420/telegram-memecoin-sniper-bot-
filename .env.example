# Postgres
DATABASE_URL=postgres://snipr:snipr@localhost:5432/snipr

# Minimum USD to unlock Activate
MIN_FUND_USD=100

# Promo banner
PROMO_HOURS=48
PROMO_ENABLED=true

# Price feed
COINGECKO_API_URL=https://api.coingecko.com/api/v3

# RPC endpoints (replace with dedicated providers before real funds)
