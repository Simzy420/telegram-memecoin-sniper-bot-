{
  "name": "telegram-memecoin-sniper-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram bot that snipes (auto-buys) newly launched memecoins, with a safe dry-run simulation mode.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "sniper-bot": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "simulate": "tsx src/simulator.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "telegraf": "4.16.3"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@types/node": "22.10.2",
    "@typescript-eslint/eslint-plugin": "8.18.2",
    "@typescript-eslint/parser": "8.18.2",
    "eslint": "9.17.0",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
